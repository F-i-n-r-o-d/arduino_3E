/*
  Rehabilitační veslařská tyč
  - MPU6050 (I2C) měří náklon tyče
  - detekuje jednotlivé záběry, počítá je a měří tempo (záběry/min)
  - LED pásek WS2812B ukazuje, jak dobré je tempo (více LED = lepší tempo)

  Zapojení (Arduino Uno/Nano):
    MPU6050: VCC->3.3V/5V, GND->GND, SDA->A4, SCL->A5
    LED pásek: DIN->pin 6 (přes odpor ~330 ohm), napájení 5V (externí zdroj
               u delšího pásku!), GND společná

  Knihovna: Adafruit NeoPixel (Sketch -> Include Library -> Manage Libraries)
*/

#include <Wire.h>
#include <Adafruit_NeoPixel.h>

// ====================== NASTAVENÍ ======================
#define LED_PIN        6
#define NUM_LEDS       30      // počet LED na tyči
#define LED_BRIGHTNESS 80      // 0-255

// Detekce záběru (úhly náklonu ve stupních)
const float ANGLE_HIGH = 15.0;  // tyč přitažena (konec záběru)
const float ANGLE_LOW  = -15.0; // tyč natažena vpřed (začátek záběru)
const unsigned long MIN_STROKE_MS = 1000;  // nejkratší možný záběr (max 60 záb/min)
const unsigned long TIMEOUT_MS    = 5000;  // bez záběru takto dlouho = tempo 0

// Cílové tempo (záběry za minutu)
const float TARGET_SPM    = 22.0;  // ideální tempo
const float TOLERANCE_SPM = 10.0;  // při odchylce >= této hodnoty svítí 0 LED

// Který směr je "náklon"? Pokud máš senzor otočený jinak, přepni osu:
// 0 = osa X, 1 = osa Y
#define TILT_AXIS 0
// =======================================================

Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

const int MPU_ADDR = 0x68;

// --- stav měření ---
float angle = 0;             // vyfiltrovaný úhel
bool  wasLow = false;        // byla tyč v poloze "LOW" od posledního záběru?
unsigned long lastStrokeMs = 0;
unsigned long strokeCount  = 0;
float spm = 0;               // vyhlazené tempo
float displayLevel = 0;      // vyhlazený počet svítících LED (0..NUM_LEDS)
unsigned long flashUntil = 0;
unsigned long lastDebug = 0;

// ---------------------- MPU6050 ----------------------
void mpuInit() {
  Wire.begin();
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);  // PWR_MGMT_1
  Wire.write(0);     // probudit senzor
  Wire.endTransmission(true);
}

bool readAngle(float &outAngle) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);  // ACCEL_XOUT_H
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(MPU_ADDR, 6, true) != 6) return false;

  int16_t ax = (Wire.read() << 8) | Wire.read();
  int16_t ay = (Wire.read() << 8) | Wire.read();
  int16_t az = (Wire.read() << 8) | Wire.read();

  float fx = ax / 16384.0, fy = ay / 16384.0, fz = az / 16384.0;  // v "g"

  // náklon z gravitace
  if (TILT_AXIS == 0) outAngle = atan2(fx, sqrt(fy * fy + fz * fz)) * 180.0 / PI;
  else                outAngle = atan2(fy, sqrt(fx * fx + fz * fz)) * 180.0 / PI;
  return true;
}

// ---------------------- LED ----------------------
uint32_t colorForScore(float score) {  // 0 = červená, 1 = zelená
  uint8_t r = (uint8_t)(255 * (1.0 - score));
  uint8_t g = (uint8_t)(255 * score);
  return strip.Color(r, g, 0);
}

void showLeds(float score) {
  // plynulé dobíhání displeje
  float target = score * NUM_LEDS;
  displayLevel += (target - displayLevel) * 0.1;

  strip.clear();

  if (millis() < flashUntil) {
    // krátké modré bliknutí při každém detekovaném záběru
    for (int i = 0; i < NUM_LEDS; i++) strip.setPixelColor(i, strip.Color(0, 0, 60));
  }

  int lit = (int)(displayLevel + 0.5);
  for (int i = 0; i < lit && i < NUM_LEDS; i++) {
    // barva se mění podél pásku: začátek červený, konec zelený
    float pos = (float)i / (NUM_LEDS - 1);
    strip.setPixelColor(i, colorForScore(pos));
  }

  // každých 10 záběrů krátce bílá na konci tyče
  if (strokeCount > 0 && strokeCount % 10 == 0 && millis() < flashUntil) {
    strip.setPixelColor(NUM_LEDS - 1, strip.Color(255, 255, 255));
  }
  strip.show();
}

// ---------------------- Detekce záběru ----------------------
void onStroke(unsigned long now) {
  strokeCount++;
  flashUntil = now + 120;

  if (lastStrokeMs != 0) {
    float period = (now - lastStrokeMs) / 1000.0;     // sekundy
    float instSpm = 60.0 / period;
    spm = (spm == 0) ? instSpm : (0.6 * spm + 0.4 * instSpm);  // vyhlazení
  }
  lastStrokeMs = now;
}

void detectStroke(unsigned long now) {
  if (angle < ANGLE_LOW) wasLow = true;

  // záběr = tyč byla vpředu (LOW) a nyní přešla do polohy HIGH
  if (wasLow && angle > ANGLE_HIGH) {
    if (lastStrokeMs == 0 || now - lastStrokeMs >= MIN_STROKE_MS) {
      onStroke(now);
    }
    wasLow = false;
  }

  // dlouho bez záběru -> reset tempa
  if (lastStrokeMs != 0 && now - lastStrokeMs > TIMEOUT_MS) {
    spm = 0;
    lastStrokeMs = 0;
  }
}

// ---------------------- Arduino ----------------------
void setup() {
  Serial.begin(115200);
  mpuInit();
  strip.begin();
  strip.setBrightness(LED_BRIGHTNESS);
  strip.show();

  // krátký úvodní test LED
  for (int i = 0; i < NUM_LEDS; i++) {
    strip.setPixelColor(i, strip.Color(0, 0, 80));
    strip.show();
    delay(15);
  }
  strip.clear();
  strip.show();
}

void loop() {
  static unsigned long lastSample = 0;
  unsigned long now = millis();
  if (now - lastSample < 10) return;  // ~100 Hz
  lastSample = now;

  float raw;
  if (readAngle(raw)) {
    angle = 0.8 * angle + 0.2 * raw;  // low-pass filtr proti otřesům
    detectStroke(now);
  }

  // skóre 0..1: čím blíž cílovému tempu, tím vyšší
  float score = 0;
  if (spm > 0) {
    score = 1.0 - fabs(spm - TARGET_SPM) / TOLERANCE_SPM;
    score = constrain(score, 0.0, 1.0);
  }
  showLeds(score);

  // ladění: Serial Plotter / Monitor (115200 baud)
  if (now - lastDebug > 100) {
    lastDebug = now;
    Serial.print("uhel:");   Serial.print(angle);
    Serial.print(" zabery:"); Serial.print(strokeCount);
    Serial.print(" tempo:");  Serial.println(spm);
  }
}
