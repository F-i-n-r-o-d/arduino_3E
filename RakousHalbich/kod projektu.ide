#include <WiFiNINA.h>
#include <ArduinoJson.h>
#include <FastLED.h>
#include <Arduino_LSM6DS3.h> // Vstavený akcelerometr na Nano RP2040 Connect
 
// --- WIFI NASTAVENÍ (Změň na své hodnoty) ---
const char* ssid = "simon - iphone"; //název wifi
const char* password = "simasima"; //heslo Wifi
const char* serverUrl = ""; // IP adresa počítače (místo localhostu)
 
// --- HARDWARE NASTAVENÍ ---
#define LED_PIN     6       // Digitální pin na Nano RP2040 pro LED pásek
#define NUM_LEDS    64      // Počet diod na tyči
#define BRIGHTNESS  100     // Jas LED (0-255)
#define LED_TYPE    WS2812B
#define COLOR_ORDER GRB
 
CRGB leds[NUM_LEDS];
 
// --- HERNÍ PROMĚNNÉ ---
float ballPos = 0.0;        // Pozice kuličky (0.0 až 63.9)
float ballSpeed = 0.4;      // Rychlost pohybu
int direction = 1;          // 1 = doprava, -1 = doleva
int score = 0;              // Počet úspěšných přihrávek
bool gameRunning = true;    // Stav hry
 
const int ZONE_SIZE = 6;    // Odrazové zóny na koncích
 
void setup() {
  Serial.begin(115200);
  while (!Serial); // Čeká na otevření sériového monitoru (volitelné)
 
  // Inicializace LED pásku
  FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS);
  FastLED.setBrightness(BRIGHTNESS);
 
  // Inicializace vestavěného akcelerometru LSM6DS3
  if (!IMU.begin()) {
    Serial.println("Chyba: Vestavěný akcelerometr LSM6DS3 nelze spustit!");
    while (1);
  }
 
  // Připojení k Wi-Fi (pomocí WiFiNINA modulu na desce)
  Serial.print("Pripojovani k Wi-Fi: ");
  Serial.println(ssid);
 
  while (WiFi.status() != WL_CONNECTED) {
    WiFi.begin(ssid, password);
    delay(1000);
    Serial.print(".");
  }
 
  Serial.println("\nPripojeno k Wi-Fi!");
  Serial.print("IP adresa desky: ");
  Serial.println(WiFi.localIP());
 
  resetGame();
}
 
void loop() {
  if (!gameRunning) {
    // Konec hry - blikání červeně
    fill_solid(leds, NUM_LEDS, CRGB::Red);
    FastLED.show();
    delay(500);
    fill_solid(leds, NUM_LEDS, CRGB::Black);
    FastLED.show();
    delay(500);
    return;
  }
 
  // 1. Čtení vestavěného akcelerometru
  float x, y, z;
  bool playerSwung = false;
 
  if (IMU.accelerationAvailable()) {
    IMU.readAcceleration(x, y, z);
    // Detekce prudkého švihu
    if (abs(x) > 1.5 || abs(y) > 1.5) {
      playerSwung = true;
    }
  }
 
  // 2. Pohyb kuličky
  ballPos += ballSpeed * direction;
 
  // 3. Kontrola konců tyče (Konec hry)
  if (ballPos < 0 || ballPos >= NUM_LEDS) {
    gameOver();
    return;
  }
 
  // 4. Kontrola odrazových zón
  int currentLed = round(ballPos);
 
  // Zóna hráče A (začátek)
  if (currentLed <= ZONE_SIZE && direction == -1) {
    if (playerSwung) {
      direction = 1;
      score++;
      ballSpeed += 0.05;
      flashZone(0, ZONE_SIZE, CRGB::Green);
    }
  }
 
  // Zóna hráče B (konec)
  if (currentLed >= (NUM_LEDS - ZONE_SIZE) && direction == 1) {
    if (playerSwung) {
      direction = -1;
      score++;
      ballSpeed += 0.05;
      flashZone(NUM_LEDS - ZONE_SIZE, NUM_LEDS, CRGB::Green);
    }
  }
 
  // 5. Vykreslení na LED pásek
  FastLED.clear();
 
  for (int i = 0; i <= ZONE_SIZE; i++) leds[i] = CRGB::Blue;
  for (int i = NUM_LEDS - ZONE_SIZE; i < NUM_LEDS; i++) leds[i] = CRGB::Blue;
 
  leds[currentLed] = CRGB::White;
 
  FastLED.show();
  delay(30);
}
 
void resetGame() {
  ballPos = NUM_LEDS / 2;
  ballSpeed = 0.5;
  direction = 1;
  score = 0;
  gameRunning = true;
}
 
void flashZone(int start, int end, CRGB color) {
  for (int i = start; i < end; i++) leds[i] = color;
  FastLED.show();
  delay(100);
}
 
void gameOver() {
  gameRunning = false;
  Serial.println("Hra skončila! Kulička vyjela z tyče.");
  Serial.print("Skóre (přihrávek): ");
  Serial.println(score);
 
  // Odeslání JSON dat přes Wi-Fi na server (počítač)
  WiFiClient client;
  // Rozparsování URL nebo přímé volání serveru
  // Pro zjednodušení předpokládáme server na portu 3000
  if (client.connect("192.168.1.100", 3000)) {
    JsonDocument doc;
    doc["game"] = "1D_Ping_Pong_NanoRP2040";
    doc["score"] = score;
    doc["status"] = "game_over";
 
    String requestBody;
    serializeJson(doc, requestBody);
 
    client.println("POST /api/score HTTP/1.1");
    client.println("Host: 192.168.1.100:3000");
    client.println("Content-Type: application/json");
    client.print("Content-Length: ");
    client.println(requestBody.length());
    client.println("Connection: close");
    client.println();
    client.print(requestBody);
 
    Serial.println("Skóre úspěšně odesláno na počítač!");
    client.stop();
  } else {
    Serial.println("Chyba: Nepodařilo se připojit k serveru na počítači.");
  }
}
 